<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site2.master.cs" Inherits="EducationProject.Site2" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>Admin dashboard</title>
    <link rel="stylesheet" href="Content/bootstrap.css" />
    <link href="~/Content/styles.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style>
        body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #F3E5F5;
    color: #4A148C;
    margin: 0;
    padding: 0;
}

h1 {
    font-size: 24px;
    padding: 10px;
}

.grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 20px;
}

.card {
    background-color: white;
    border: 1px solid #9B30FF;
    border-radius: 8px;
    width: calc(25% - 20px);
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.card-header {
    background-color: #6A0DAD;
    color: white;
    padding: 10px;
    font-weight: bold;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

.card-body {
    padding: 15px;
}

.btn-primary {
    background-color: #9B30FF;
    color: white;
    padding: 8px 12px;
    text-decoration: none;
    border-radius: 4px;
    display: inline-block;
    margin-top: 10px;
}

.btn-primary:hover {
    background-color: #7A1DCC;
}

.navbar {
    background-color: #6A0DAD;
    padding: 10px;
}

footer {
    background-color: #6A0DAD;
    color: white;
    text-align: center;
    padding: 10px;
    margin-top: 40px;
}
    </style>
</head>
<body>
  <form id="form1" runat="server">
        <div class="container-fluid">
            <div class="row">
                <!-- Sidebar Navigation -->
                <div class="col-md-2">
                    <asp:Menu ID="NavigationMenu" runat="server" CssClass="nav flex-column">
                        <Items>
                            <asp:MenuItem Text="Admin Dashboard" NavigateUrl="~/AdminDashboard.aspx" />
                            <asp:MenuItem Text="Manage Users" NavigateUrl="~/ManageUsers.aspx" />
                            <asp:MenuItem Text="Approve Tutors" NavigateUrl="~/ApproveTutors.aspx" />
                            <asp:MenuItem Text="Approve Courses" NavigateUrl="~/ApproveCourses.aspx" />
                            <asp:MenuItem Text="Manage Courses" NavigateUrl="~/ManageCourses.aspx" />
                            <asp:MenuItem Text="Revenue Report" NavigateUrl="~/RevenueReport.aspx" />
                            <asp:MenuItem Text="Manage Payments" NavigateUrl="~/ManagePayments.aspx" />
                            <asp:MenuItem Text="User Analytics" NavigateUrl="~/UserAnalytics.aspx" />
                            <asp:MenuItem Text="Financial Reports" NavigateUrl="~/FinancialReports.aspx" />
                        </Items>
                    </asp:Menu>
                </div>

                <!-- Main Content Area -->
                <div class="col-md-10">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </div>
            </div>
        </div>
    </form>
</body>
</html>
